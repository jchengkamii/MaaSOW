# Python environments and generated bytecode
.venv/
__pycache__/
*.py[cod]
*$py.class

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local runtime state (may contain paths, logs or WebView session data)
cache/
debug/
config/mxu-*.json
*.pid
*.lock
*.log

# Full source screenshots are not required at runtime
reference_screenshots/

# Track the frontend and bundled MaaFramework runtime used by the distribution.
# Keep unrelated executables ignored.
*.exe
!/九霄仙府自动化测试.exe
!/maafw/**/*.exe

# Obsolete extension directory; Python cases now live under cases/<case_id>/
extensions/

# Local secrets
.env
.env.*
!.env.example

# Distribution build artifacts and local downloaded runtime
build/
dist/
.runtime/
