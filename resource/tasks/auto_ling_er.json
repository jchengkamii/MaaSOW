{
  "version": 1,
  "id": "auto_ling_er",
  "name": "自动玲儿降妖",
  "group": "日常任务",
  "description": "自动识别兽潮首领页签中的妖兽洞穴或普通兽潮首领，搜索指定等级并集结；仅勾选队列参与循环，各队确认集结中、出征、返回并消失后计入总次数。",
  "order": 76,
  "default_checked": true,
  "enabled": true,
  "handler": "python",
  "extension": "agent.custom.action.auto_ling_er:run",
  "auto_stamina": true,
  "parameters": {
    "rally_level": 1,
    "rally_count": 1,
    "rally_queues": [
      1
    ]
  }
}
