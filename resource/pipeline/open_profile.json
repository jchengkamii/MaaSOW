{
    "打开或确认宗门信息": {
        "next": ["宗门信息已打开", "从聊天页返回主界面", "点击左上角头像"],
        "timeout": 20000
    },
    "宗门信息已打开": {
        "recognition": "TemplateMatch",
        "template": "game/profile_opened.png",
        "threshold": 0.72
    },
    "点击左上角头像": {
        "recognition": "TemplateMatch",
        "template": "game/avatar_button.png",
        "threshold": 0.75,
        "roi": [0, 50, 140, 160],
        "action": "Click",
        "next": ["宗门信息已打开"],
        "timeout": 10000
    },
    "从聊天页返回主界面": {
        "recognition": "TemplateMatch",
        "template": "game/chat_back_button.png",
        "threshold": 0.75,
        "roi": [0, 1120, 160, 194],
        "action": "Click",
        "next": ["点击左上角头像"],
        "timeout": 10000
    }
}
