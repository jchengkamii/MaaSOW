{
  "group": [
    {
      "name": "group_01",
      "label": "启动",
      "default_expand": true
    },
    {
      "name": "group_02",
      "label": "日常任务",
      "default_expand": true
    },
    {
      "name": "group_03",
      "label": "后台辅助",
      "default_expand": true
    }
  ],
  "task": [
    {
      "name": "close_face_popups",
      "label": "关闭拍脸弹窗",
      "entry": "MXU执行外部用例",
      "default_check": false,
      "description": "循环关闭右上角带×或可点击遮罩关闭的拍脸弹窗，断言内城完整界面加载完成",
      "group": [
        "group_01"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "close_face_popups"
          }
        }
      }
    },
    {
      "name": "auto_radar",
      "label": "自动雷达（没做完）",
      "entry": "MXU执行外部用例",
      "default_check": false,
      "description": "从内城或大世界进入执事堂，优先领取和一键执行，再逐个处理雷达事件",
      "group": [
        "group_02"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_radar"
          }
        }
      }
    },
    {
      "name": "auto_treatment",
      "label": "自动治疗",
      "entry": "MXU执行外部用例",
      "default_check": true,
      "description": "循环治疗伤兵：按设置的单次目标时长治疗，仙盟互助后等待完成并自动收取",
      "group": [
        "group_02"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_treatment"
          }
        }
      },
      "option": [
        "自动治疗时长"
      ]
    },
    {
      "name": "auto_help",
      "label": "开启自动帮助（需要单独执行）",
      "entry": "MXU执行外部用例",
      "default_check": true,
      "description": "启动独立后台监视；按钮每次出现只点击一次，其他用例执行期间自动暂停",
      "group": [
        "group_03"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_help"
          }
        }
      }
    },
    {
      "name": "stop_auto_help",
      "label": "停止自动帮助（需要单独执行）",
      "entry": "MXU执行外部用例",
      "default_check": true,
      "description": "停止由“开启自动帮助”启动的后台监视进程",
      "group": [
        "group_03"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "stop_auto_help"
          }
        }
      }
    },
    {
      "name": "auto_pixiu",
      "label": "自动打貔貅",
      "entry": "MXU执行外部用例",
      "default_check": true,
      "description": "查找祥瑞聚宝活动，搜索灵貅，空闲队列自动出征；次数按确认出征计数。目前不支持大貔貅。",
      "group": [
        "group_02"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_pixiu"
          }
        }
      },
      "option": [
        "自动补体",
        "貔貅进攻次数"
      ]
    },
    {
      "name": "auto_ling_er",
      "label": "自动玲儿降妖",
      "entry": "MXU执行外部用例",
      "default_check": true,
      "description": "搜索指定等级妖兽洞穴，仅勾选队列参与集结循环；各队确认集结中、出征、返回并消失后计入总次数。",
      "group": [
        "group_02"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_ling_er"
          }
        },
        "玲儿集结队列1": {
          "enabled": false
        },
        "玲儿集结队列2": {
          "enabled": false
        },
        "玲儿集结队列3": {
          "enabled": false
        },
        "玲儿集结队列4": {
          "enabled": false
        }
      },
      "option": [
        "自动补体",
        "玲儿集结设置",
        "玲儿集结队列"
      ]
    }
  ],
  "option": {
    "自动补体": {
      "type": "checkbox",
      "label": "",
      "default_case": [
        "自动补体"
      ],
      "cases": [
        {
          "name": "自动补体",
          "label": "自动补体",
          "pipeline_override": {
            "通用自动补体开关": {
              "enabled": true
            }
          }
        }
      ]
    },
    "自动治疗时长": {
      "type": "input",
      "label": "",
      "description": "设置每批治疗的目标时长（分钟）",
      "inputs": [
        {
          "name": "目标分钟",
          "label": "分钟",
          "description": "请输入 1–10000 的整数，默认 40 分钟",
          "default": "40",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]\\d{0,3}|10000)$",
          "pattern_msg": "请输入 1–10000 的整数"
        }
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_treatment",
            "target_minutes": "{目标分钟}"
          }
        }
      }
    },
    "貔貅进攻次数": {
      "type": "input",
      "label": "",
      "description": "设置进攻次数，以确认小队出征计数",
      "inputs": [
        {
          "name": "进攻次数",
          "label": "进攻次数",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]\\d{0,3}|10000)$",
          "pattern_msg": "请输入 1–10000 的整数"
        }
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_pixiu",
            "attack_count": "{进攻次数}"
          }
        }
      }
    },
    "玲儿集结设置": {
      "type": "input",
      "label": "",
      "description": "勾选队列共同完成集结总次数，返回并消失后计数；等级须在游戏可选范围内",
      "inputs": [
        {
          "name": "集结等级",
          "label": "集结等级",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^[1-9]\\d?$",
          "pattern_msg": "请输入 1–99 的整数"
        },
        {
          "name": "集结次数",
          "label": "集结次数",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]\\d{0,3}|10000)$",
          "pattern_msg": "请输入 1–10000 的整数"
        }
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_ling_er",
            "rally_level": "{集结等级}",
            "rally_count": "{集结次数}"
          }
        }
      }
    },
    "玲儿集结队列": {
      "type": "checkbox",
      "label": "集结队列",
      "description": "仅勾选队列参与循环；至少选择一队，默认只选 1",
      "default_case": [
        "1"
      ],
      "cases": [
        {
          "name": "1",
          "label": "1",
          "pipeline_override": {
            "玲儿集结队列1": {
              "enabled": true
            }
          }
        },
        {
          "name": "2",
          "label": "2",
          "pipeline_override": {
            "玲儿集结队列2": {
              "enabled": true
            }
          }
        },
        {
          "name": "3",
          "label": "3",
          "pipeline_override": {
            "玲儿集结队列3": {
              "enabled": true
            }
          }
        },
        {
          "name": "4",
          "label": "4",
          "pipeline_override": {
            "玲儿集结队列4": {
              "enabled": true
            }
          }
        }
      ]
    }
  }
}
