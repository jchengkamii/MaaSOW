{
  "group": [
    {
      "name": "group_01",
      "label": "启动",
      "default_expand": true
    },
    {
      "name": "group_02",
      "label": "日常任务",
      "default_expand": true
    },
    {
      "name": "group_03",
      "label": "后台辅助",
      "default_expand": true
    }
  ],
  "task": [
    {
      "name": "close_face_popups",
      "label": "关闭拍脸弹窗",
      "entry": "MXU执行外部用例",
      "default_check": true,
      "description": "循环关闭右上角带×或可点击遮罩关闭的拍脸弹窗，断言内城完整界面加载完成",
      "group": [
        "group_01"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "close_face_popups"
          }
        }
      }
    },
    {
      "name": "auto_radar",
      "label": "自动雷达",
      "entry": "MXU执行外部用例",
      "default_check": false,
      "description": "从内城或大世界进入执事堂，优先领取和一键执行，再逐个处理雷达事件",
      "group": [
        "group_02"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_radar"
          }
        }
      }
    },
    {
      "name": "auto_treatment",
      "label": "自动治疗",
      "entry": "MXU执行外部用例",
      "default_check": false,
      "description": "循环治疗伤兵：按设置的单次目标时长治疗，仙盟互助后等待完成并自动收取",
      "group": [
        "group_02"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_treatment"
          }
        }
      },
      "option": [
        "自动治疗时长"
      ]
    },
    {
      "name": "auto_help",
      "label": "▶ 开启自动帮助",
      "entry": "MXU执行外部用例",
      "default_check": false,
      "description": "启动独立后台监视；按钮每次出现只点击一次，其他用例执行期间自动暂停",
      "group": [
        "group_03"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_help"
          }
        }
      }
    },
    {
      "name": "stop_auto_help",
      "label": "■ 停止自动帮助",
      "entry": "MXU执行外部用例",
      "default_check": false,
      "description": "停止由“开启自动帮助”启动的后台监视进程",
      "group": [
        "group_03"
      ],
      "controller": [
        "WeChatOrGame"
      ],
      "resource": [
        "Default"
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "stop_auto_help"
          }
        }
      }
    }
  ],
  "option": {
    "自动治疗时长": {
      "type": "input",
      "label": "",
      "description": "设置每批治疗的目标时长（分钟）",
      "inputs": [
        {
          "name": "目标分钟",
          "label": "分钟",
          "description": "请输入 1–10000 的整数，默认 30 分钟",
          "default": "30",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]\\d{0,3}|10000)$",
          "pattern_msg": "请输入 1–10000 的整数"
        }
      ],
      "pipeline_override": {
        "MXU执行外部用例": {
          "custom_action_param": {
            "case_id": "auto_treatment",
            "target_minutes": "{目标分钟}"
          }
        }
      }
    }
  }
}
